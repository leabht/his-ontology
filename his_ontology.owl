                                <owl:someValuesFrom rdf:resource="http://www.example.org/HIS_ontology#Technique"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


