    <!-- http://www.example.org/HIS_ontology#Agent -->

    <owl:Class rdf:about="http://www.example.org/HIS_ontology#Agent">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
